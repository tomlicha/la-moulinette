<workout_file>
  <author>La Moulinette</author>
  <name>Découverte &amp; seuil</name>
  <description>Séance de démonstration : échauffement, 4 × 1 min, palier au seuil, retour au calme. 23 min.</description>
  <sportType>bike</sportType>
  <workout>
    <!-- échauffement progressif -->
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.75" Cadence="90"/>
    <IntervalsT Repeat="4" OnDuration="60" OffDuration="60" OnPower="1.10" OffPower="0.55" Cadence="100" CadenceResting="85">
      <textevent timeoffset="0" message="Premier effort, cadence haute"/>
      <textevent timeoffset="360" message="Dernier effort !"/>
    </IntervalsT>
    <SteadyState Duration="300" Power="0.95">
      <textevent timeoffset="150" message="Mi-palier, reste régulier"/>
    </SteadyState>
    <FreeRide Duration="60" FlatRoad="1"/>
    <Cooldown Duration="240" PowerLow="0.65" PowerHigh="0.40"/>
  </workout>
</workout_file>
