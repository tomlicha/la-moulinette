# Copier ce fichier en .env.local (ignoré par le dépôt) et renseigner les valeurs de l'application Strava.
# Créer l'application : https://www.strava.com/settings/api avec « Authorization Callback Domain » = localhost
# Ces variables n'ont pas le préfixe VITE_ : elles restent dans le serveur de dev et ne sont jamais envoyées au navigateur.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# intervals.icu : clé d'API personnelle (https://intervals.icu/settings, tout en bas, section « Developer Settings »).
# Sans abonnement. Même règle : pas de préfixe VITE_, la clé reste dans le serveur de dev.
INTERVALS_API_KEY=

# Journaux d'erreurs (src/telemetry/). Le serveur de dev reçoit déjà les rapports dans .logs/reports.jsonl sans rien configurer.
# LOG_READ_TOKEN : jeton de lecture du serveur de dev. Pour `npm run logs:serve`, LOG_READ_TOKEN et LOG_INGEST_TOKEN sont
# lus dans l'environnement du processus (pas dans ce fichier). Jetons à choisir soi-même, longs et aléatoires.
LOG_READ_TOKEN=
# Build de production de l'application : adresse du récepteur et jeton d'envoi. VITE_ => lus par le navigateur : le jeton
# d'envoi n'est donc pas un secret, il limite seulement le bruit. Ne jamais mettre LOG_READ_TOKEN ici.
# VITE_LOG_ENDPOINT=https://logs.exemple.fr/api/logs/ingest
# VITE_LOG_TOKEN=
